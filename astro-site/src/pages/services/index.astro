---
import Layout from '../../components/Layout.astro';
import { getSettings, getServices } from '../../lib/directus';

const settings = await getSettings();
const servicesRes = await getServices();
const services = servicesRes?.data ?? [];

const categories = services.reduce((acc: Record<string, any[]>, service) => {
  const key = service.service_type ?? 'other';
  if (!acc[key]) acc[key] = [];
  acc[key].push(service);
  return acc;
}, {});

const categoryOrder = [
  'shipping',
  'notary',
  'printing',
  'packing',
  'mailboxes',
  'shredding',
  'binding',
  'luggage',
  'other'
];

const orderedCategories = categoryOrder.filter((key) => categories[key]?.length).map((key) => ({
  key,
  services: categories[key]
}));
---
<Layout
  settings={settings}
  title={`Services | ${settings?.business_name ?? 'Westside Shipping & More'}`}
  description="Explore shipping, printing, mailbox, packing, notary, and specialty services available from Westside Shipping & More."
>
  <section class="hero container">
    <h1>Services that scale with your to-do list</h1>
    <p>
      Whether you need overnight shipping, compliant notary service, or expert packing, our veteran-led team is ready to help. Browse
      the options below or call us for tailored recommendations.
    </p>
  </section>

  <section class="service-section container">
    {orderedCategories.length === 0 ? (
      <p>No services are published yet. Please add services in Directus.</p>
    ) : (
      orderedCategories.map((group) => (
        <div class="service-group" id={group.key}>
          <h2>{group.key.charAt(0).toUpperCase() + group.key.slice(1)} Services</h2>
          <div class="grid">
            {group.services.map((service) => (
              <article class="card">
                <h3>{service.name}</h3>
                <p>{service.summary}</p>
                <a class="btn" href={`/services/${service.slug}`} data-track-event="cta_click" data-track-label={`Services Hub: ${service.name}`} data-track-location="services">
                  Learn more
                </a>
              </article>
            ))}
          </div>
        </div>
      ))
    )}
  </section>
</Layout>

<style>
  .hero {
    padding: 3rem 1.5rem 2rem;
    max-width: 720px;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .service-section {
    margin-top: 2rem;
    display: grid;
    gap: 3rem;
  }

  .service-group h2 {
    margin-bottom: 1rem;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .card {
    background: #ffffff;
    border-radius: 1rem;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--color-accent);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 8px 18px rgba(15, 98, 254, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(15, 98, 254, 0.25);
  }
</style>
