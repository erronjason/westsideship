---
import Layout from '../components/Layout.astro';
import { getSettings } from '../lib/directus';

const settings = await getSettings();
---
<Layout settings={settings} title={`Page not found | ${settings?.business_name ?? 'Westside Shipping & More'}`}>
  <section class="container not-found">
    <h1>Page not found</h1>
    <p>We couldn&apos;t locate that page. Try one of our primary services or contact the team for help.</p>
    <div class="actions">
      <a class="btn" href="/">Return home</a>
      <a class="btn secondary" href="/services">View services</a>
      <a class="btn tertiary" href="/shipping">Shipping calculator</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .not-found h1 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }

  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    background: var(--color-accent);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
  }

  .btn.secondary {
    background: transparent;
    color: var(--color-accent-text);
    border: 2px solid var(--color-accent);
  }

  .btn.tertiary {
    background: var(--color-accent-subtle);
    color: var(--color-accent-text);
  }
</style>
