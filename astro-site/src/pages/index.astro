---
import { getServices, getPickupTimes } from '../lib/directus';
const weekday = new Date().toLocaleDateString('en-US', { weekday: 'short' }).replace('.', '');
const [servicesRes, pickupsRes] = await Promise.all([ getServices(), getPickupTimes(weekday) ]);
const services = servicesRes.data ?? [];
const pickups = pickupsRes.data ?? [];
---
<html>
  <head><meta charset="utf-8" /><title>Westside Shipping & More</title></head>
  <body>
    <h1>Printing, Packing, Shipping, Mailbox, Notary, Shredding</h1>
    <section>
      <h2>Today’s Pickup Times</h2>
      {pickups.length === 0 ? <p>No pickups scheduled today.</p> : (
        <ul>
          {pickups.map((p) => <li><strong>{p.carrier}</strong> – {p.service}: {p.cutoff_time} {p.notes ? `(${p.notes})` : ''}</li>)}
        </ul>
      )}
    </section>

    <section>
      <h2>Services</h2>
      <ul>
        {services.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            {s.cta_url && <a href={s.cta_url}>{s.cta_label || 'Learn more'}</a>}
          </li>
        ))}
      </ul>
    </section>
  </body>
</html>
